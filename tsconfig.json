{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,

    "paths": {
      "@shared/*": ["./shared/*"],
      "@server/*": ["./server/*"],
      "@config": ["./config.json"]
    }
  },
  "include": ["shared/**/*.ts", "server/**/*.ts", "web/src/**/*.ts", "web/src/**/*.tsx", "tests/**/*.ts", "vite.config.ts"]
}
